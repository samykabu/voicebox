# Copy this file to .env before starting the CUDA Compose overlay.
# The base compose file publishes Voicebox at http://127.0.0.1:17600.

# All GPUs are available by default. Use a GPU index/UUID, or a comma-separated
# list, to keep Voicebox away from GPUs used by other inference containers.
VOICEBOX_NVIDIA_VISIBLE_DEVICES=all

# Runtime limits for the Voicebox container.
VOICEBOX_CPU_LIMIT=8
VOICEBOX_MEMORY_LIMIT=16G
VOICEBOX_SHM_SIZE=2gb

# Native inference packages, pinned to the versions validated by the Arabic
# F5-TTS/Habibi portal deployment.
F5_TTS_VERSION=1.1.21
HABIBI_TTS_VERSION=0.1.1
